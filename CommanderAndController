<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Commander and Controller</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #050505;
            color: #00ff00;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        canvas {
            background: #111;
            box-shadow: 0 0 30px rgba(0, 255, 0, 0.1);
            max-width: 100%;
            max-height: 100%;
        }

        #ui-layer {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            display: flex; flex-direction: column; justify-content: space-between;
            z-index: 10;
        }

        .pointer-enabled { pointer-events: auto; }

        .top-bar {
            background: linear-gradient(to bottom, rgba(0,0,0,0.9), rgba(0,0,0,0.5));
            padding: 10px;
            display: flex; justify-content: space-between; align-items: center;
            border-bottom: 1px solid #333;
        }

        .health-bars { display: flex; gap: 20px; align-items: center; }
        .hp-box { display: flex; flex-direction: column; align-items: center; min-width: 60px; }
        .hp-pips { display: flex; gap: 4px; margin-top: 4px; }
        .pip { width: 15px; height: 8px; background: #333; border: 1px solid #000; }
        .pip.active-allied { background: #00ff00; box-shadow: 0 0 5px #00ff00; }
        .pip.active-brothers { background: #ff0000; box-shadow: 0 0 5px #ff0000; }

        .missile-timer {
            width: 120px; height: 8px; background: #222;
            border: 1px solid #555; border-radius: 4px; overflow: hidden; margin: 0 10px;
        }
        #missile-fill { height: 100%; width: 0%; transition: width 0.1s linear; }

        #pause-btn {
            background: #222; color: #00ff00; border: 1px solid #00ff00;
            padding: 5px 10px; font-weight: bold; cursor: pointer; font-family: monospace; border-radius: 3px;
        }

        .build-menu {
            background: linear-gradient(to top, rgba(0,10,0,0.95), rgba(0,10,0,0.6));
            padding: 10px; display: flex; gap: 8px; overflow-x: auto;
            justify-content: center; border-top: 1px solid #00ff00; padding-bottom: 20px;
        }

        .card {
            width: 65px; height: 80px; background: #001a00;
            border: 1px solid #004400; border-radius: 4px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            cursor: pointer; position: relative; transition: all 0.1s;
        }
        .card:active { transform: scale(0.95); background: #003300; }
        .card.disabled { opacity: 0.4; filter: grayscale(1); pointer-events: none; }
        .card-icon { font-size: 24px; margin-bottom: 5px; }
        .card-cost { color: #ffff00; font-weight: bold; font-size: 11px; position: absolute; top: 2px; right: 4px; }
        .card-name { font-size: 9px; color: #aaa; text-align: center; width: 100%; overflow: hidden; white-space: nowrap; }

        .modal-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 100; pointer-events: auto;
        }
        .modal-overlay.hidden { display: none !important; }
        
        .modal-overlay h1 { color: #00ff00; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px; font-size: 32px; text-align: center;}
        
        .btn-large {
            background: #00ff00; color: black; border: none; padding: 15px 30px;
            font-size: 18px; font-weight: bold; cursor: pointer; margin-top: 20px;
            text-transform: uppercase; min-width: 200px; margin-bottom: 10px;
        }
        .btn-large:hover { background: #44ff44; }
        .btn-large.secondary { background: transparent; border: 2px solid #00ff00; color: #00ff00; }
        .btn-large.secondary:hover { background: rgba(0,255,0,0.1); }

        .resource-display {
            position: absolute; bottom: 110px; left: 20px; font-size: 24px;
            color: #00ff00; font-weight: bold; text-shadow: 0 0 5px #000;
            pointer-events: none; z-index: 20;
        }

        .click-feedback {
            position: absolute; width: 20px; height: 20px;
            border: 2px solid white; border-radius: 50%;
            transform: translate(-50%, -50%); pointer-events: none;
            animation: ripple 0.5s ease-out forwards; z-index: 90;
        }
        @keyframes ripple {
            0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
            100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }
        }
    </style>
</head>
<body>

<div id="game-container">
    <canvas id="gameCanvas"></canvas>
    
    <div id="ui-layer">
        <div class="top-bar pointer-enabled">
            <div class="health-bars">
                <div class="hp-box">
                    <span style="color:#ff4444; font-size:10px; font-weight:bold;">BROTHERS</span>
                    <div class="hp-pips" id="enemy-hp">
                        <div class="pip active-brothers"></div><div class="pip active-brothers"></div>
                    </div>
                </div>
            </div>
            
            <div style="display:flex; flex-direction:column; align-items:center;">
                <div class="missile-timer"><div id="missile-fill"></div></div>
            </div>

            <div class="health-bars">
                 <div class="hp-box">
                    <span style="color:#00ff00; font-size:10px; font-weight:bold;">ALLIED</span>
                    <div class="hp-pips" id="player-hp">
                        <div class="pip active-allied"></div><div class="pip active-allied"></div>
                    </div>
                </div>
                <button id="pause-btn" onclick="togglePause()">||</button>
            </div>
        </div>

        <div class="resource-display">$ <span id="money-display">0</span></div>

        <div class="build-menu pointer-enabled" id="build-menu">
            <!-- Cards generated by JS -->
        </div>
    </div>

    <div id="modal-start" class="modal-overlay">
        <h1>Commander<br>and Controller</h1>
        <p style="color:#ccc; text-align:center; padding:0 20px; font-size: 14px; line-height: 1.5;">
            Lead the <strong>Allied</strong> forces to victory against the <strong>Brothers</strong>.<br><br>
            <span style="color:#ffff00">System Upgrade: Pathfinding Online</span><br>
            <span style="color:#aaa">Units will now automatically navigate around mountains.</span>
        </p>
        <button class="btn-large" onclick="startGame()">Start Mission</button>
    </div>

    <div id="modal-pause" class="modal-overlay hidden">
        <h1>PAUSED</h1>
        <button class="btn-large" onclick="togglePause()">Resume</button>
        <button class="btn-large secondary" onclick="restartGame()">Restart Mission</button>
    </div>

    <div id="modal-end" class="modal-overlay hidden">
        <h1 id="end-title">GAME OVER</h1>
        <button class="btn-large" onclick="restartGame()">Play Again</button>
    </div>
</div>

<script>
/**
 * COMMANDER AND CONTROLLER - ENGINE
 */

const AudioContext = window.AudioContext || window.webkitAudioContext;
let audioCtx;
let audioEnabled = false;

const SFX = {
    init: () => {
        try {
            if (!AudioContext) return;
            if (!audioCtx) audioCtx = new AudioContext();
            if (audioCtx.state === 'suspended') { audioCtx.resume().then(() => { audioEnabled = true; }); } 
            else { audioEnabled = true; }
        } catch (e) { audioEnabled = false; }
    },
    playTone: (type, f1, f2, dur, v1, v2) => {
        if (!audioEnabled || isPaused || !audioCtx) return;
        try {
            const o = audioCtx.createOscillator(); const g = audioCtx.createGain();
            o.connect(g); g.connect(audioCtx.destination); o.type = type;
            o.frequency.setValueAtTime(f1, audioCtx.currentTime);
            o.frequency.exponentialRampToValueAtTime(f2, audioCtx.currentTime + dur);
            g.gain.setValueAtTime(v1, audioCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(v2, audioCtx.currentTime + dur);
            o.start(); o.stop(audioCtx.currentTime + dur);
        } catch(e){}
    },
    shoot: () => SFX.playTone('square', 400, 100, 0.1, 0.05, 0.001),
    tank: () => SFX.playTone('sawtooth', 100, 20, 0.2, 0.1, 0.001),
    launch: () => SFX.playTone('triangle', 200, 600, 0.3, 0.05, 0),
    explode: () => {
        if (!audioEnabled || isPaused || !audioCtx) return;
        try {
            const buf = audioCtx.createBuffer(1, audioCtx.sampleRate*0.3, audioCtx.sampleRate);
            const d = buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i] = Math.random()*2-1;
            const n = audioCtx.createBufferSource(); n.buffer = buf;
            const g = audioCtx.createGain(); n.connect(g); g.connect(audioCtx.destination);
            g.gain.setValueAtTime(0.1, audioCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+0.3);
            n.start();
        } catch(e){}
    },
    nukeExplosion: () => {
        if (!audioEnabled || isPaused || !audioCtx) return;
        try {
            const buf = audioCtx.createBuffer(1, audioCtx.sampleRate*4, audioCtx.sampleRate);
            const d = buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i] = (Math.random()*2-1)*Math.exp(-i/(audioCtx.sampleRate*0.8));
            const n = audioCtx.createBufferSource(); n.buffer = buf;
            const f = audioCtx.createBiquadFilter(); f.type='lowpass';
            f.frequency.setValueAtTime(100, audioCtx.currentTime); f.frequency.linearRampToValueAtTime(10, audioCtx.currentTime+4);
            const g = audioCtx.createGain();
            g.gain.setValueAtTime(0.5, audioCtx.currentTime); g.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime+4);
            n.connect(f); f.connect(g); g.connect(audioCtx.destination); n.start();
        } catch(e){}
    }
};

const CONFIG = {
    gridCols: 11, gridRows: 15,
    tileSize: 0, gridOffsetX: 0, gridOffsetY: 0,
    startMoney: 200,
    colors: { p: '#44ff44', e: '#ff4444', tib: '#00ff66', pad: '#ffff00', mountain: '#555' }
};

let canvas, ctx;
let gameActive = false;
let isPaused = false;
let money = 0;
let enemyMoney = 0;
let units = [];
let particles = [];
let projectiles = [];
let selectedUnit = null;
let missileVal = 0;
let bases = { p: 2, e: 2 }; 
let lastFrameTime = 0;
let spawnFlash = 0;
let mushroomCloud = null;
let GRID = [];

// --- A* Pathfinding ---
class Node {
    constructor(x, y, p, g, h) { this.x=x; this.y=y; this.p=p; this.g=g; this.h=h; this.f=g+h; }
}

function findPath(unit, tx, ty) {
    const startX = Math.round(unit.x);
    const startY = Math.round(unit.y);
    
    // Air units don't need pathfinding (straight line)
    if (unit.type === 'air') return [{x: tx, y: ty}];
    
    // If target is invalid (mountain), try finding nearest valid neighbor
    if (GRID[ty] && GRID[ty][tx] === 1) return [];

    const open = [];
    const closed = new Set();
    open.push(new Node(startX, startY, null, 0, Math.abs(tx-startX) + Math.abs(ty-startY)));

    while (open.length > 0) {
        let curr = open[0];
        let idx = 0;
        for (let i=1; i<open.length; i++) {
            if (open[i].f < curr.f) { curr = open[i]; idx = i; }
        }
        open.splice(idx, 1);
        closed.add(`${curr.x},${curr.y}`);

        if (curr.x === tx && curr.y === ty) {
            const path = [];
            while(curr.p) { path.unshift({x: curr.x, y: curr.y}); curr = curr.p; }
            return path;
        }

        const neighbors = [
            {x:0, y:-1}, {x:0, y:1}, {x:-1, y:0}, {x:1, y:0}
        ];

        for (let n of neighbors) {
            const nx = curr.x + n.x;
            const ny = curr.y + n.y;

            if (ny < 0 || ny >= CONFIG.gridRows || nx < 0 || nx >= CONFIG.gridCols) continue;
            if (GRID[ny][nx] === 1) continue; // Mountain check
            if (closed.has(`${nx},${ny}`)) continue;

            const gScore = curr.g + 1;
            let neighbor = open.find(node => node.x === nx && node.y === ny);

            if (!neighbor) {
                const h = Math.abs(tx-nx) + Math.abs(ty-ny);
                open.push(new Node(nx, ny, curr, gScore, h));
            } else if (gScore < neighbor.g) {
                neighbor.g = gScore;
                neighbor.f = neighbor.g + neighbor.h;
                neighbor.p = curr;
            }
        }
    }
    return []; // No path found
}

function generateMap() {
    GRID = [];
    const cols = CONFIG.gridCols;
    const rows = CONFIG.gridRows;
    const cx = Math.floor(cols/2);
    const cy = Math.floor(rows/2);

    for (let r = 0; r < rows; r++) {
        let row = [];
        for (let c = 0; c < cols; c++) row.push(0);
        GRID.push(row);
    }

    GRID[0][cx] = 4; 
    GRID[rows-1][cx] = 4; 

    const pads = [
        {r: 4, c: 2}, {r: 4, c: cols-3},
        {r: cy, c: cx},
        {r: rows-5, c: 2}, {r: rows-5, c: cols-3}
    ];
    pads.forEach(p => GRID[p.r][p.c] = 3);

    const tibs = [
        {r: 1, c: 1}, {r: 1, c: cols-2},
        {r: rows-2, c: 1}, {r: rows-2, c: cols-2},
        {r: cy, c: 1}, {r: cy, c: cols-2}
    ];
    tibs.forEach(p => GRID[p.r][p.c] = 2);

    for (let r = 2; r < Math.floor(rows/2); r++) {
        for (let c = 1; c < cols - 1; c++) {
            if (GRID[r][c] !== 0) continue;
            if (Math.abs(c - cx) <= 1 && r < 4) continue; 

            if (Math.random() < 0.20) {
                GRID[r][c] = 1;
                GRID[r][cols - 1 - c] = 1;
                GRID[rows - 1 - r][c] = 1;
                GRID[rows - 1 - r][cols - 1 - c] = 1;
            }
        }
    }
}

const DB = {
    rifle: { n:'Rifle', cost:10, hp:60, dmg:10, spd:0.03, rng:1.5, cd:40, icon:'🏃', type:'infantry', proj:'bullet', mods: { infantry: 1.0, vehicle: 0.05, air: 0.05 } },
    missile: { n:'Missile', cost:30, hp:50, dmg:40, spd:0.025, rng:3.5, cd:90, icon:'🚀', type:'infantry', proj:'missile', mods: { infantry: 0.2, vehicle: 1.2, air: 1.5 } },
    buggy: { n:'Buggy', cost:40, hp:120, dmg:12, spd:0.05, rng:1.5, cd:15, icon:'🚙', type:'vehicle', proj:'bullet', mods: { infantry: 2.5, vehicle: 0.2, air: 0.1 } },
    tank: { n:'Tank', cost:70, hp:350, dmg:60, spd:0.02, rng:2.0, cd:100, icon:'🛡️', type:'vehicle', proj:'bullet', mods: { infantry: 0.1, vehicle: 1.0, air: 0.0 } },
    orca: { n:'Orca', cost:90, hp:120, dmg:50, spd:0.04, rng:2.5, cd:120, icon:'✈️', type:'air', proj:'missile', mods: { infantry: 0.2, vehicle: 1.5, air: 0.0 } },
    harv: { n:'Harvester', cost:50, hp:350, dmg:0, spd:0.015, rng:0, cd:0, icon:'🚜', type:'vehicle', harvest:true, proj:'none', mods: {} }
};

class MushroomCloud {
    constructor(x, y) { this.x = x; this.y = y; this.life = 300; this.maxLife = 300; }
    update() { this.life--; }
    draw(ctx, ts) {
        const progress = 1 - (this.life / this.maxLife);
        const stemWidth = Math.max(0, ts * 0.5 * Math.min(progress * 5, 1));
        const stemHeight = Math.max(0, ts * 3 * Math.min(progress * 2, 1));
        const capRadius = Math.max(0, ts * 1.5 * Math.min(progress * 3, 1) + (Math.sin(Date.now()/100) * 5));
        const shake = (Math.random() - 0.5) * 5;
        const cx = this.x * ts + ts/2 + shake;
        const cy = this.y * ts + ts/2;
        let cInner, cOuter;
        if (progress < 0.2) { cInner = '#fff'; cOuter = '#ff0'; }
        else if (progress < 0.5) { cInner = '#ff0'; cOuter = '#f00'; }
        else if (progress < 0.8) { cInner = '#f40'; cOuter = '#333'; }
        else { cInner = '#333'; cOuter = '#000'; }
        ctx.globalAlpha = Math.min(this.life / 60, 1);
        try {
            const grdStem = ctx.createLinearGradient(cx, cy, cx, cy - stemHeight);
            grdStem.addColorStop(0, cOuter); grdStem.addColorStop(1, cInner);
            ctx.fillStyle = grdStem; ctx.beginPath(); ctx.ellipse(cx, cy - stemHeight/2, stemWidth/2, stemHeight/2, 0, 0, Math.PI*2); ctx.fill();
            if (progress > 0.1) {
                ctx.strokeStyle = 'rgba(255,255,255,0.5)'; ctx.lineWidth = 10;
                ctx.beginPath(); ctx.ellipse(cx, cy - stemHeight * 0.3, stemWidth * 1.5 * progress, stemWidth * 0.5 * progress, 0, 0, Math.PI*2); ctx.stroke();
            }
            const grdCap = ctx.createRadialGradient(cx, cy - stemHeight, 0, cx, cy - stemHeight, capRadius);
            grdCap.addColorStop(0, cInner); grdCap.addColorStop(0.5, cOuter); grdCap.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = grdCap; ctx.beginPath(); ctx.arc(cx, cy - stemHeight, capRadius, 0, Math.PI*2); ctx.fill();
        } catch(e) { ctx.fillStyle='white'; ctx.beginPath(); ctx.arc(cx, cy, ts, 0, Math.PI*2); ctx.fill(); }
        ctx.globalAlpha = 1;
    }
}

class Unit {
    constructor(key, owner, x, y) {
        const d = DB[key];
        this.key = key; this.owner = owner;
        this.x = x; this.y = y;
        this.vx = x; this.vy = y;
        this.hp = d.hp; this.maxHp = d.hp;
        this.dmg = d.dmg; this.cdMax = d.cd; this.cd = 0;
        this.spd = d.spd; this.rng = d.rng;
        this.type = d.type; this.projType = d.proj;
        this.mods = d.mods || {}; this.harvest = d.harvest || false;
        this.state = 'idle';
        this.path = []; // Pathfinding path
    }
    
    setPath(tx, ty) {
        this.path = findPath(this, tx, ty);
        if (this.path.length > 0) {
            this.state = 'move';
        }
    }

    update() {
        if (this.cd > 0) this.cd--;
        this.vx += (this.x - this.vx) * 0.1;
        this.vy += (this.y - this.vy) * 0.1;

        if (this.state === 'move') {
            if (this.path.length > 0) {
                const next = this.path[0];
                const dx = next.x - this.x;
                const dy = next.y - this.y;
                const dist = Math.sqrt(dx*dx + dy*dy);
                
                if (dist > this.spd) {
                    this.x += (dx/dist) * this.spd;
                    this.y += (dy/dist) * this.spd;
                } else {
                    this.x = next.x;
                    this.y = next.y;
                    this.path.shift(); // Reached node, remove it
                }
            } else {
                this.state = 'idle';
                if (this.harvest && GRID[Math.round(this.y)] && GRID[Math.round(this.y)][Math.round(this.x)] === 2) this.state = 'harvest';
            }
        } else if (this.state === 'idle' || this.state === 'harvest') {
            const target = this.findTarget();
            if (target) {
                const dist = Math.hypot(this.x - target.x, this.y - target.y);
                if (dist <= this.rng) this.attack(target);
            }
        }
    }
    findTarget() {
        let best = null; let maxDmg = 0;
        units.forEach(u => {
            if (u.owner !== this.owner) {
                const d = Math.hypot(this.x - u.x, this.y - u.y);
                if (d <= this.rng) {
                    let mult = this.mods[u.type] !== undefined ? this.mods[u.type] : 1.0;
                    const potentDmg = this.dmg * mult;
                    if (potentDmg > 1 && potentDmg > maxDmg) { maxDmg = potentDmg; best = u; }
                }
            }
        });
        if (!best) units.forEach(u => { if (u.owner !== this.owner && Math.hypot(this.x - u.x, this.y - u.y) <= this.rng) best = u; });
        return best;
    }
    attack(target) {
        if (this.cd > 0) return;
        this.cd = this.cdMax;
        let mult = this.mods[target.type] !== undefined ? this.mods[target.type] : 1.0;
        const finalDmg = this.dmg * mult;
        if (this.projType === 'missile') {
            SFX.launch();
            projectiles.push({ type: 'missile', x: this.vx, y: this.vy, target: target, tx: target.vx, ty: target.vy, dmg: finalDmg, owner: this.owner, speed: 0.04, color: this.owner === 1 ? '#ffff00' : '#ffaa00' });
        } else {
            if (this.key === 'tank') SFX.tank(); else SFX.shoot();
            target.takeDamage(finalDmg);
            projectiles.push({ type: 'bullet', sx: this.vx, sy: this.vy, tx: target.vx, ty: target.vy, color: this.owner === 1 ? '#0f0' : '#f00', life: 10 });
        }
    }
    takeDamage(amt) {
        this.hp -= amt;
        addParticles(this.vx, this.vy, 3, '#ffaa00');
        if (this.hp <= 0) {
            addParticles(this.vx, this.vy, 10, '#ffffff');
            units = units.filter(u => u !== this);
            if (selectedUnit === this) selectedUnit = null;
        }
    }
}

function initInput() {
    canvas.addEventListener('mousedown', (e) => handleInput(e.clientX, e.clientY));
    canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        handleInput(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: false });
}

function handleInput(clientX, clientY) {
    if (!gameActive || isPaused) return;
    if (CONFIG.tileSize <= 0) return;
    createRipple(clientX, clientY);
    const rect = canvas.getBoundingClientRect();
    const xRel = clientX - rect.left;
    const yRel = clientY - rect.top;
    const gridXFloat = (xRel - CONFIG.gridOffsetX) / CONFIG.tileSize;
    const gridYFloat = (yRel - CONFIG.gridOffsetY) / CONFIG.tileSize;
    const gx = Math.floor(gridXFloat);
    const gy = Math.floor(gridYFloat);
    if (gx >= 0 && gx < CONFIG.gridCols && gy >= 0 && gy < CONFIG.gridRows) {
        handleGridInteraction(gx, gy);
    } else {
        selectedUnit = null;
    }
}

function handleGridInteraction(gx, gy) {
    if (!GRID[gy]) return;
    const clickedUnit = units.find(u => Math.hypot(u.x - gx, u.y - gy) < 0.8);
    if (clickedUnit && clickedUnit.owner === 1) {
        selectedUnit = clickedUnit;
        return;
    }
    if (selectedUnit) {
        if (clickedUnit && clickedUnit.owner === -1) { 
            // Move towards enemy to attack
            selectedUnit.setPath(gx, gy);
        } else {
            // Move to tile
            selectedUnit.setPath(gx, gy);
            if (selectedUnit.path.length > 0) {
                particles.push({x:gx, y:gy, type:'marker', life:20});
            } else {
                addParticles(gx, gy, 5, '#555'); // Blocked
            }
        }
    }
}

function createRipple(x, y) {
    const el = document.createElement('div');
    el.className = 'click-feedback';
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 500);
}

function init() {
    canvas = document.getElementById('gameCanvas');
    ctx = canvas.getContext('2d');
    generateMap(); 
    resize();
    window.addEventListener('resize', resize);
    initInput();
    const menu = document.getElementById('build-menu');
    Object.keys(DB).forEach(k => {
        const d = DB[k];
        const btn = document.createElement('div');
        btn.className = 'card';
        btn.innerHTML = `<span class="card-cost">${d.cost}</span><div class="card-icon">${d.icon}</div><div class="card-name">${d.n}</div>`;
        btn.onclick = (e) => { e.stopPropagation(); buyUnit(k); };
        btn.id = `btn-${k}`;
        btn.dataset.cost = d.cost;
        menu.appendChild(btn);
    });
    requestAnimationFrame(loop);
}

function resize() {
    if (!canvas) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const maxW = canvas.width;
    const maxH = canvas.height; 
    const tileW = maxW / CONFIG.gridCols;
    const tileH = maxH / CONFIG.gridRows;
    CONFIG.tileSize = Math.max(1, Math.floor(Math.min(tileW, tileH)));
    const gridPixelW = CONFIG.tileSize * CONFIG.gridCols;
    const gridPixelH = CONFIG.tileSize * CONFIG.gridRows;
    CONFIG.gridOffsetX = (canvas.width - gridPixelW) / 2;
    CONFIG.gridOffsetY = (canvas.height - gridPixelH) / 2;
}

function buyUnit(key) {
    if (!gameActive || isPaused) return; 
    const d = DB[key];
    if (money >= d.cost) {
        const spawnRows = [CONFIG.gridRows - 1, CONFIG.gridRows - 2];
        let placed = false;
        for (let r of spawnRows) {
            for (let c = 0; c < CONFIG.gridCols; c++) {
                const occupied = units.some(u => Math.round(u.tx) === c && Math.round(u.ty) === r);
                const terrain = GRID[r] ? GRID[r][c] : 0; 
                if (!occupied && (terrain !== 1 || d.type === 'air')) {
                    money -= d.cost;
                    const u = new Unit(key, 1, c, r);
                    units.push(u);
                    selectedUnit = u;
                    placed = true;
                    spawnFlash = 10;
                    break;
                }
            }
            if (placed) break;
        }
        if (!placed) addParticles(Math.floor(CONFIG.gridCols/2), CONFIG.gridRows-1, 10, 'red');
    }
}

function togglePause() {
    if (!gameActive && document.getElementById('modal-start').classList.contains('hidden') === false) return; 
    if (!gameActive && document.getElementById('modal-end').classList.contains('hidden') === false) return; 
    isPaused = !isPaused;
    const menu = document.getElementById('modal-pause');
    if (isPaused) menu.classList.remove('hidden'); else menu.classList.add('hidden');
}

function resetGameVars() {
    money = CONFIG.startMoney;
    enemyMoney = 0;
    units = []; particles = []; projectiles = [];
    missileVal = 0; bases = { p: 2, e: 2 }; spawnFlash = 0; selectedUnit = null; isPaused = false; mushroomCloud = null;
    updateHP();
    document.getElementById('missile-fill').style.width = '0%';
    generateMap();
}

function startGame() {
    document.getElementById('modal-start').classList.add('hidden');
    resetGameVars();
    gameActive = true;
    SFX.init();
}

function restartGame() {
    resetGameVars();
    gameActive = true;
    document.getElementById('modal-pause').classList.add('hidden');
    document.getElementById('modal-end').classList.add('hidden');
    SFX.init();
}

function endGame(msg) {
    gameActive = false;
    document.getElementById('modal-end').classList.remove('hidden');
    document.getElementById('end-title').innerText = msg;
    document.getElementById('end-title').style.color = msg.includes('VICTORY') ? '#0f0':'#f00';
}

function loop(ts) {
    const dt = ts - lastFrameTime;
    lastFrameTime = ts;
    try {
        if (gameActive && !isPaused) {
            if (ts % 1000 < 20) {
                let inc = 3;
                units.forEach(u => { if(u.owner===1 && u.state==='harvest') inc += 4; });
                money += inc;
                let eInc = 3;
                units.forEach(u => { if(u.owner===-1 && u.state==='harvest') eInc += 4; });
                enemyMoney += eInc;
            }
            updateAI();
            updateMissile();
            units.forEach(u => u.update());
            projectiles = projectiles.filter(p => {
                if (p.type === 'nuke') {
                    const dx = p.tx - p.x; const dy = p.ty - p.y; const dist = Math.sqrt(dx*dx + dy*dy);
                    if (dist < p.speed) {
                        SFX.nukeExplosion();
                        mushroomCloud = new MushroomCloud(p.tx, p.ty);
                        const winner = p.owner === 1 ? 1 : -1;
                        if (winner === 1) bases.e--; else bases.p--;
                        updateHP();
                        return false;
                    } else {
                        p.x += (dx/dist) * p.speed; p.y += (dy/dist) * p.speed;
                        if (Math.random() > 0.1) { particles.push({x:p.x, y:p.y, life:30, c:'#aaa', size:0.3}); particles.push({x:p.x, y:p.y, life:20, c:'#ff0', size:0.2}); }
                        return true;
                    }
                }
                if (p.type === 'bullet') { p.life--; return p.life > 0; }
                else if (p.type === 'missile') {
                    if (p.target && units.includes(p.target)) { p.tx = p.target.vx; p.ty = p.target.vy; }
                    const dx = p.tx - p.x; const dy = p.ty - p.y; const dist = Math.sqrt(dx*dx + dy*dy);
                    if (dist < p.speed) {
                        if (p.target && units.includes(p.target)) { p.target.takeDamage(p.dmg); }
                        SFX.explode(); addParticles(p.x, p.y, 6, 'orange');
                        return false;
                    } else {
                        p.x += (dx/dist) * p.speed; p.y += (dy/dist) * p.speed;
                        if (Math.random() > 0.3) particles.push({x:p.x, y:p.y, life:10, c:'rgba(100,100,100,0.5)', size:0.1});
                        return true;
                    }
                }
                return false;
            });
            
            if (mushroomCloud) {
                mushroomCloud.update();
                if (mushroomCloud.life <= 0) {
                    if (bases.p <= 0) endGame('DEFEAT'); else if (bases.e <= 0) endGame('ALLIED VICTORY'); else mushroomCloud = null; 
                }
            }
            particles = particles.filter(p => { p.life--; return p.life > 0; });
            if (spawnFlash > 0) spawnFlash--;
            document.getElementById('money-display').innerText = Math.floor(money);
            document.querySelectorAll('.card').forEach(b => {
                const cost = parseInt(b.dataset.cost);
                if (money < cost) b.classList.add('disabled'); else b.classList.remove('disabled');
            });
        }
        draw();
    } catch (e) { console.error("Loop error", e); }
    requestAnimationFrame(loop);
}

function updateAI() {
    if (Math.random() > 0.05) return;
    if (enemyMoney > 20) {
        const eUnits = units.filter(u => u.owner === -1);
        if (eUnits.length < 5) {
            const keys = Object.keys(DB);
            const key = keys[Math.floor(Math.random() * keys.length)];
            const d = DB[key];
            if (enemyMoney >= d.cost) {
                const rows = [0, 1];
                let placed = false;
                for(let r of rows) {
                    for(let c=0; c<CONFIG.gridCols; c++) {
                        const occ = units.some(u=>Math.round(u.tx)===c && Math.round(u.ty)===r);
                        const ter = GRID[r] ? GRID[r][c] : 0;
                        if(!occ && (ter!==1 || d.type==='air')) {
                            enemyMoney -= d.cost;
                            const u = new Unit(key, -1, c, r);
                            units.push(u);
                            placed = true;
                            break;
                        }
                    }
                    if(placed) break;
                }
            }
        }
    }
    const eUnits = units.filter(u => u.owner === -1);
    const cx = Math.floor(CONFIG.gridCols/2);
    const cy = Math.floor(CONFIG.gridRows/2);
    const pads = [{x:2,y:4}, {x:CONFIG.gridCols-3,y:4}, {x:cx,y:cy}, {x:2,y:CONFIG.gridRows-5}, {x:CONFIG.gridCols-3,y:CONFIG.gridRows-5}];
    eUnits.forEach(u => {
        if (u.state === 'idle' && !u.harvest) {
            if (Math.random() < 0.1) {
                const p = pads[Math.floor(Math.random()*pads.length)];
                if (GRID[p.y]) {
                    u.setPath(p.x, p.y);
                }
            } else {
                if (u.y < CONFIG.gridRows - 2) { 
                    const ny = Math.floor(u.y)+1; const nx = Math.floor(u.x);
                    if(GRID[ny]) u.setPath(nx, ny);
                }
            }
        }
    });
}

function updateMissile() {
    if (projectiles.some(p => p.type === 'nuke') || mushroomCloud) return;
    let pCount = 0, eCount = 0;
    for(let r=0; r<CONFIG.gridRows; r++){
        for(let c=0; c<CONFIG.gridCols; c++){
            if(GRID[r] && GRID[r][c] === 3) {
                const u = units.find(u => Math.round(u.x)===c && Math.round(u.y)===r);
                if(u) { if(u.owner === 1) pCount++; if(u.owner === -1) eCount++; }
            }
        }
    }
    const bar = document.getElementById('missile-fill');
    let speed = 0.083; 
    if (pCount > eCount) { bar.style.backgroundColor = CONFIG.colors.p; missileVal += speed; }
    else if (eCount > pCount) { bar.style.backgroundColor = CONFIG.colors.e; missileVal += speed; }
    else { bar.style.backgroundColor = '#555'; }
    if (missileVal >= 100) {
        missileVal = 0;
        const winner = pCount > eCount ? 1 : -1;
        const cx = Math.floor(CONFIG.gridCols/2); const cy = Math.floor(CONFIG.gridRows/2);
        projectiles.push({ type: 'nuke', x: cx, y: cy, tx: cx, ty: winner === 1 ? 0 : CONFIG.gridRows-1, speed: 0.005, owner: winner });
    }
    bar.style.width = Math.min(missileVal, 100) + '%';
}

function updateHP() {
    const pContainer = document.getElementById('player-hp');
    pContainer.innerHTML = '';
    for(let i=0; i<2; i++) { const d = document.createElement('div'); d.className = 'pip ' + (i < bases.p ? 'active-allied':''); pContainer.appendChild(d); }
    const eContainer = document.getElementById('enemy-hp');
    eContainer.innerHTML = '';
    for(let i=0; i<2; i++) { const d = document.createElement('div'); d.className = 'pip ' + (i < bases.e ? 'active-brothers':''); eContainer.appendChild(d); }
}

function draw() {
    if (!canvas || CONFIG.tileSize <= 0) return;
    ctx.fillStyle = '#111'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.save();
    ctx.translate(CONFIG.gridOffsetX, CONFIG.gridOffsetY);
    const ts = CONFIG.tileSize;
    for(let r=0; r<CONFIG.gridRows; r++) {
        for(let c=0; c<CONFIG.gridCols; c++) {
            if (!GRID[r]) continue; 
            const type = GRID[r][c]; const x = c*ts, y = r*ts;
            ctx.strokeStyle = '#222'; ctx.strokeRect(x,y,ts,ts);
            if(type===1) { 
                ctx.fillStyle = '#444'; ctx.beginPath(); ctx.moveTo(x + ts*0.1, y + ts*0.9); ctx.lineTo(x + ts*0.5, y + ts*0.1); ctx.lineTo(x + ts*0.9, y + ts*0.9); ctx.fill();
                ctx.fillStyle = '#666'; ctx.beginPath(); ctx.moveTo(x + ts*0.5, y + ts*0.1); ctx.lineTo(x + ts*0.6, y + ts*0.4); ctx.lineTo(x + ts*0.4, y + ts*0.4); ctx.fill();
            }
            if(type===2) { ctx.fillStyle = 'rgba(0,255,100,0.1)'; ctx.fillRect(x+2,y+2,ts-4,ts-4); ctx.fillStyle = CONFIG.colors.tib; ctx.beginPath(); ctx.arc(x+ts/2, y+ts/2, ts/4, 0, Math.PI*2); ctx.fill(); }
            if(type===3) {
                const u = units.find(u => Math.round(u.x)===c && Math.round(u.y)===r);
                ctx.fillStyle = u ? (u.owner===1?CONFIG.colors.p : CONFIG.colors.e) : '#555';
                ctx.globalAlpha = 0.3; ctx.fillRect(x+5,y+5,ts-10,ts-10); ctx.globalAlpha = 1.0;
                ctx.strokeStyle = ctx.fillStyle; ctx.lineWidth = 2; ctx.strokeRect(x+10,y+10,ts-20,ts-20);
            }
            if(type===4) { ctx.fillStyle = r<2 ? '#400':'#040'; ctx.fillRect(x+5,y+5,ts-10,ts-10); }
        }
    }
    if (spawnFlash > 0) { ctx.fillStyle = 'rgba(0,255,0,0.3)'; ctx.fillRect(0, (CONFIG.gridRows-2)*ts, CONFIG.gridCols*ts, 2*ts); }
    units.forEach(u => {
        const cx = u.vx * ts + ts/2; const cy = u.vy * ts + ts/2; const r = ts * 0.35; const time = Date.now();
        let animY = 0; let animScale = 1; let shadowOff = 0;
        if (u.type === 'air') { animY = Math.sin(time / 200) * (ts * 0.1); shadowOff = ts * 0.2; }
        if (u.state === 'move') {
            if (u.type === 'infantry') { animY = Math.abs(Math.sin(time / 100)) * (ts * 0.15) * -1; }
            else if (u.type === 'vehicle') { animY = (Math.random() - 0.5) * (ts * 0.05); }
        } else if (u.state === 'harvest') { animY = (Math.random() - 0.5) * (ts * 0.05); animScale = 1 + Math.sin(time / 50) * 0.05; }
        const drawY = cy + animY;
        if (selectedUnit === u) {
            ctx.beginPath(); ctx.arc(cx, drawY, r + 5 + Math.sin(time/100)*2, 0, Math.PI*2);
            ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();
            if (u.path.length > 0) {
                ctx.beginPath();
                ctx.moveTo(cx, drawY);
                for (let p of u.path) ctx.lineTo(p.x*ts + ts/2, p.y*ts + ts/2);
                ctx.strokeStyle = 'rgba(255,255,255,0.5)'; ctx.setLineDash([5, 5]); ctx.stroke(); ctx.setLineDash([]);
            }
        }
        if (u.type === 'air') { ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.beginPath(); ctx.ellipse(cx, cy + shadowOff, r*0.8, r*0.4, 0, 0, Math.PI*2); ctx.fill(); }
        ctx.fillStyle = u.owner===1 ? CONFIG.colors.p : CONFIG.colors.e;
        ctx.save(); ctx.translate(cx, drawY); ctx.scale(animScale, animScale);
        ctx.beginPath();
        if(u.type==='infantry') ctx.arc(0, 0, r*0.6, 0, Math.PI*2);
        else if(u.type==='vehicle') ctx.rect(-r*0.8, -r*0.8, r*1.6, r*1.6);
        else { ctx.moveTo(0, -r); ctx.lineTo(r, r); ctx.lineTo(-r, r); }
        ctx.fill();
        ctx.fillStyle = '#000'; ctx.font = (ts*0.4)+'px Arial'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(DB[u.key].icon, 0, 0);
        ctx.restore();
        const pct = u.hp / u.maxHp;
        ctx.fillStyle = 'red'; ctx.fillRect(cx-r, cy-r-12 + animY, r*2, 4);
        ctx.fillStyle = '#0f0'; ctx.fillRect(cx-r, cy-r-12 + animY, r*2*pct, 4);
    });
    projectiles.forEach(p => {
        if (p.type === 'nuke') {
            const px = p.x*ts+ts/2, py=p.y*ts+ts/2;
            ctx.save(); ctx.translate(px, py); const angle = Math.atan2(p.ty - p.y, p.tx - p.x) + Math.PI/2; ctx.rotate(angle);
            ctx.fillStyle = '#ddd'; ctx.beginPath(); ctx.ellipse(0, 0, ts*0.15, ts*0.4, 0, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = '#f00'; ctx.beginPath(); ctx.moveTo(-ts*0.15, ts*0.2); ctx.lineTo(-ts*0.25, ts*0.4); ctx.lineTo(0, ts*0.3); ctx.fill();
            ctx.beginPath(); ctx.moveTo(ts*0.15, ts*0.2); ctx.lineTo(ts*0.25, ts*0.4); ctx.lineTo(0, ts*0.3); ctx.fill();
            ctx.restore();
        } else if (p.type === 'bullet') {
            const sx = p.sx*ts+ts/2, sy=p.sy*ts+ts/2; const tx = p.tx*ts+ts/2, ty=p.ty*ts+ts/2;
            ctx.beginPath(); ctx.moveTo(sx,sy); ctx.lineTo(tx,ty); ctx.strokeStyle = p.color; ctx.lineWidth = 3; ctx.stroke();
        } else if (p.type === 'missile') {
            const px = p.x*ts+ts/2, py=p.y*ts+ts/2;
            ctx.fillStyle = p.color; ctx.beginPath(); ctx.arc(px, py, ts*0.12, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(px, py, ts*0.05, 0, Math.PI*2); ctx.fill();
        }
    });
    particles.forEach(p => {
        const px = p.x*ts+ts/2, py=p.y*ts+ts/2;
        if (p.type === 'marker') {
            const r = Math.max(0, ts/2 - (20-p.life)); // FIX: Safety Clamp
            ctx.beginPath(); ctx.arc(px,py, r, 0, Math.PI*2);
            ctx.strokeStyle = 'rgba(255,255,255,'+(p.life/20)+')'; ctx.stroke();
        } else {
            ctx.fillStyle = p.c || 'orange'; const s = p.size ? ts*p.size : ts*0.2;
            ctx.beginPath(); ctx.arc(px,py, s * (p.life/10), 0, Math.PI*2); ctx.fill();
        }
    });
    if (mushroomCloud) mushroomCloud.draw(ctx, ts);
    if (isPaused) { ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(0,0, CONFIG.gridCols*ts, CONFIG.gridRows*ts); }
    ctx.restore();
}

function addParticles(x, y, count, color) {
    for(let i=0; i<count; i++) { particles.push({ x:x+(Math.random()-0.5), y:y+(Math.random()-0.5), life:15, c:color }); }
}

init();

</script>
